# Copy to .env and fill in. Never commit .env. Leave a platform's values empty to skip it.

# --- LinkedIn ---
# Access token (lasts 60 days). Scopes: openid profile w_member_social for your profile;
# add w_organization_social r_organization_social rw_organization_admin for a company page.
LINKEDIN_ACCESS_TOKEN=
# Company page ID (the number in linkedin.com/company/<id>/admin). Empty = personal profile only.
LINKEDIN_ORGANIZATION_ID=
# Optional. "person" or "organization". Default: the company page when one is set.
# LINKEDIN_DEFAULT_AUTHOR=
# Optional. Only if LinkedIn issued your app a refresh token; lets the server renew the access token.
# LINKEDIN_REFRESH_TOKEN=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Optional. Your member ID, if the token lacks the openid/profile scopes.
# LINKEDIN_PERSON_ID=
# Optional. LinkedIn API version, YYYYMM.
# LINKEDIN_VERSION=202609

# --- Facebook and Instagram (one Meta app) ---
# Long-lived user token or Page token. Permissions: pages_show_list pages_manage_posts
# pages_read_engagement pages_manage_engagement read_insights instagram_basic
# instagram_content_publish instagram_manage_comments instagram_manage_insights
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Optional. Found automatically from the Page when empty.
# INSTAGRAM_ACCOUNT_ID=
# Optional.
# META_GRAPH_VERSION=v25.0

# --- Scheduling ---
# Optional. A queued post is still sent if it is at most this many minutes late (default 720).
# SOCIAL_MCP_MAX_LATE_MINUTES=720
